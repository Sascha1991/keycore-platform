{
  "name": "keycore/platform",
  "description": "Foundation skeleton for the KeyCore WordPress and WooCommerce integration.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3"
  },
  "scripts": {
    "check": [
      "@validate",
      "@lint"
    ],
    "validate": "composer validate --strict",
    "lint": "find apps -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
