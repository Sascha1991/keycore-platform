KEYCORE_ENV=STAGING
KEYCORE_DEPLOYMENT_ID=staging-local-001

KEYCORE_STAGING_POSTGRES_PASSWORD=replace-with-staging-only-password
KEYCORE_STAGING_POSTGRES_PORT=15432
KEYCORE_DATABASE_URL=postgres://keycore_staging:replace-with-staging-only-password@127.0.0.1:15432/keycore_staging
KEYCORE_POSTGRES_RESOURCE_ENV=STAGING
KEYCORE_POSTGRES_RESOURCE_ID=staging-postgres-primary

KEYCORE_STAGING_REDIS_PASSWORD=replace-with-staging-only-password
KEYCORE_STAGING_REDIS_PORT=16379
KEYCORE_REDIS_URL=redis://:replace-with-staging-only-password@127.0.0.1:16379
KEYCORE_REDIS_RESOURCE_ENV=STAGING
KEYCORE_REDIS_RESOURCE_ID=staging-redis-primary
KEYCORE_REDIS_NAMESPACE=keycore:staging:staging-local-001

KEYCORE_STAGING_WORDPRESS_DB_PASSWORD=replace-with-staging-only-password
KEYCORE_STAGING_WORDPRESS_PORT=18080
KEYCORE_STAGING_PUBLIC_ORIGIN=https://staging.keyrano.de
KEYRANO_STAGING_ORIGIN=https://staging.keyrano.de
KEYRANO_STAGING_FORCE_SSL_ADMIN=true
KEYRANO_STAGING_BRIDGE_SECRET=replace-with-generated-staging-only-hmac-secret
KEYRANO_STAGING_BROWSER_MASTER_KEY=replace-with-generated-32-byte-base64-value
KEYRANO_STAGING_SYNTHETIC_KEY=SYNTHETIC_GENERATE_LOCALLY
KEYRANO_STAGING_GUEST_CLAIM_CODE=SYNTHETIC_CLAIM_GENERATE_LOCALLY_32_CHARS
KEYRANO_STAGING_CUSTOMER_A_WP_USER_ID=2
KEYRANO_STAGING_CUSTOMER_B_WP_USER_ID=3
KEYRANO_STAGING_ADMIN_USER=keyrano-staging-admin
KEYRANO_STAGING_ADMIN_PASSWORD=replace-with-generated-staging-admin-password
KEYCORE_STAGING_ADMIN_PORT=18081
KEYRANO_STAGING_ADMIN_ORIGIN=https://admin.staging.keyrano.de
KEYRANO_STAGING_ADMIN_SECURE_COOKIES=true
KEYRANO_STAGING_ADMIN_SESSION_CODE=replace-with-generated-staging-only-admin-session-code
KEYRANO_STAGING_ADMIN_SESSION_HASH_SECRET=replace-with-generated-staging-only-admin-session-hash-secret
KEYRANO_STAGING_ADMIN_CURSOR_SECRET=replace-with-generated-staging-only-admin-cursor-secret
KEYRANO_STAGING_ADMIN_CSRF_SECRET=replace-with-generated-staging-only-admin-csrf-secret
KEYRANO_STAGING_CUSTOMER_A_PASSWORD=replace-with-generated-staging-customer-password
KEYRANO_STAGING_CUSTOMER_B_PASSWORD=replace-with-generated-staging-customer-password
KEYCORE_SECURE_COOKIES=true
KEYCORE_CSRF_ENABLED=true
KEYCORE_DEBUG=false

KEYCORE_STAGING_MAIL_MODE=CAPTURE
KEYCORE_MAIL_ALLOW_EXTERNAL=false
KEYCORE_STAGING_MAIL_UI_PORT=18025
KEYCORE_STAGING_MAIL_SMTP_PORT=11025
KEYCORE_MAIL_HOST=127.0.0.1
KEYCORE_MAIL_PORT=11025

KEYCORE_STAGING_SUPPLIER_MODE=MOCK
KINGUIN_ENVIRONMENT=SANDBOX
KINGUIN_API_BASE_URL=
KINGUIN_API_KEY=
KEYCORE_ALLOW_KINGUIN_LIVE_READONLY=false
KEYCORE_ALLOW_KINGUIN_LIVE_KEY_RETRIEVAL=false
KEYCORE_KINGUIN_CONTROLLED_MUTATION_MODE=
KEYCORE_KINGUIN_CONTROLLED_KEY_RETRIEVAL_MODE=

STRIPE_ENVIRONMENT=TEST
STRIPE_SECRET_KEY=sk_test_replace_with_staging_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_staging_test_secret

KEYCORE_ENCRYPTION_RESOURCE_ENV=STAGING
KEYCORE_FULFILLMENT_MASTER_KEY=replace-with-separately-injected-staging-key
KEYCORE_FULFILLMENT_MASTER_KEY_ID=staging-fulfillment-v1
KEYCORE_ALLOW_LIVE_CUSTOMER_KEY_DELIVERY=false

KEYCORE_OPERATIONS_AUTHORITY_MODE=DISABLED
